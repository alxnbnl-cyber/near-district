# Background worker: durable jobs, reconciliation, reward periods
FROM node:24-alpine
RUN corepack enable && corepack prepare pnpm@10.30.1 --activate
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/worker/package.json apps/worker/
COPY apps/web/package.json apps/web/
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/near/package.json packages/near/
RUN pnpm install --frozen-lockfile --filter @near-district/worker... --filter @near-district/db...
COPY packages packages
COPY apps/worker apps/worker
ENV NODE_ENV=production
USER node
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:8081/ || exit 1
# Migrations run as a release step (see docs/deployment/deploy.md), not on every boot.
CMD ["pnpm", "--filter", "@near-district/worker", "start"]
