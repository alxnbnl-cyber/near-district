{
  "name": "yielvy",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @yielvy/web dev",
    "dev:worker": "pnpm --filter @yielvy/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:contract": "cd contracts/vault && cargo test",
    "build:contract": "cd contracts/vault && cargo build --target wasm32-unknown-unknown --release",
    "db:generate": "pnpm --filter @yielvy/db generate",
    "db:migrate": "pnpm --filter @yielvy/db migrate",
    "db:seed-dev": "pnpm --filter @yielvy/db seed-dev",
    "verify:live": "pnpm --filter @yielvy/near verify:live"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
