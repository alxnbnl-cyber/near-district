# ─────────────────────────────────────────────────────────────────────────────
# Yielvy environment. Copy to apps/web/.env.local (web) and set the same values
# for the worker service. NEVER commit real values. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# Shared
DATABASE_URL=postgres://yielvy:CHANGE_ME@127.0.0.1:54329/yielvy
NEAR_NETWORK=testnet                       # testnet | mainnet
NEAR_RPC_URLS=https://rpc.testnet.fastnear.com   # comma-separated, primary first (use a paid provider in production)
VAULT_CONTRACT_ID=                         # leave empty until the audited vault is deployed with approval

# Web
APP_URL=http://localhost:3210              # must be https:// in production
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URLS=https://rpc.testnet.fastnear.com
ANSWER_PEPPER=                             # >= 32 random chars; rotating it invalidates stored answers
ANSWER_ENCRYPTION_KEY=                     # 64 hex chars (AES-256-GCM key)
IP_HASH_SALT=                              # >= 16 random chars
UPLOAD_DIR=./.data/uploads                 # or mount a volume / swap the storage adapter for S3/R2
EMAIL_FROM=                                # e.g. "Yielvy <hello@yourdomain>" — required for email sign-in in production
RESEND_API_KEY=
RANDOM_DRAW_ALLOWED_COUNTRIES=             # empty = random draws disabled everywhere (default)
COUNTRY_HEADER=cf-ipcountry
# NEXT_PUBLIC_TESTNET_RHEA_CONTRACT=       # set only after verifying with: pnpm verify:live --network testnet
# NEXT_PUBLIC_TESTNET_USDC_CONTRACT=

# Worker
OPERATOR_ACCOUNT_ID=                       # dedicated operator account (NOT the vault owner)
OPERATOR_PRIVATE_KEY=                      # ed25519:... function-call key scoped to the vault; store in the platform secret manager
WORKER_CONCURRENCY=4
HEALTH_PORT=8081
